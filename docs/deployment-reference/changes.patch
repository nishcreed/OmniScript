+"""Fetch model assets once and record exact Hub revisions and local snapshot paths."""
+
+import argparse
+import json
+import shlex
+import shutil
+from pathlib import Path
+
+from src.config import PROJECT_ROOT, settings
+
+LAYOUT_REPO = "DILHTWD/documentlayoutsegmentation_YOLOv8_ondoclaynet"
+LAYOUT_FILE = "yolov8x-doclaynet-epoch64-imgsz640-initiallr1e-4-finallr1e-5.pt"
+MODEL_SPECS = {
+    "captioning": (settings.caption_model, "OMNISCRIPT_CAPTION_MODEL"),
+    "matching": (settings.itm_model, "OMNISCRIPT_ITM_MODEL"),
+    "translation": (settings.translation_model, "OMNISCRIPT_TRANSLATION_MODEL"),
+}
+
+
+def snapshot_patterns(filenames: list[str]) -> list[str]:
+    """Avoid downloading both safetensors and duplicate PyTorch weights."""
+    weights = "*.safetensors" if any(name.endswith(".safetensors") for name in filenames) else "*.bin"
+    return [weights, "*.json", "*.txt", "*.py", "*.model", "model.SRC", "model.TGT"]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--stage", choices=["all", "layout", *MODEL_SPECS], default="all")
+    parser.add_argument("--check-access-only", action="store_true", help="Check Hub access using small metadata/config files, without downloading weights.")
+    args = parser.parse_args()
+
+    from huggingface_hub import HfApi, hf_hub_download, snapshot_download
+
+    artifacts = PROJECT_ROOT / "artifacts"
+    manifest_path = artifacts / "model-manifest.json"
+    manifest = json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
+    stages = ["layout", *MODEL_SPECS] if args.stage == "all" else [args.stage]
+    api = HfApi()
+
+    # Check every requested repo before starting any large download.
+    resolved = {}
+    for stage in stages:
+        if stage == "layout" and settings.layout_model_path.is_file():
+            print(f"layout: using existing checkpoint at {settings.layout_model_path}")
+            continue
+        repo = LAYOUT_REPO if stage == "layout" else MODEL_SPECS[stage][0]
+        if Path(repo).is_dir():
+            resolved[stage] = (repo, None)
+            continue
+        previous = manifest.get(stage, {})
+        revision = previous.get("revision") if previous.get("repo") == repo else None
+        info = api.model_info(repo, revision=revision)
+        if stage != "layout":
+            hf_hub_download(repo, "config.json", revision=info.sha)
+        resolved[stage] = (repo, info)
+        print(f"{stage}: access OK ({info.sha})")
+
+    if args.check_access_only:
+        print("Access checks passed. No model weights downloaded.")
+        return
+
+    artifacts.mkdir(parents=True, exist_ok=True)
+    for stage in stages:
+        if stage == "layout":
+            destination = settings.layout_model_path.resolve()
+            if not destination.is_file():
+                repo, info = resolved[stage]
+                cached = hf_hub_download(repo, LAYOUT_FILE, revision=info.sha)
+                destination.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(cached, destination)
+                manifest[stage] = {"repo": repo, "revision": info.sha, "path": str(destination)}
+            else:
+                manifest.setdefault(stage, {"path": str(destination), "source": "existing checkpoint"})
+        else:
+            repo, info = resolved[stage]
+            if info is None:
+                destination = Path(repo).resolve()
+                manifest.setdefault(stage, {"path": str(destination), "source": "existing snapshot"})
+            else:
+                destination = Path(snapshot_download(
+                    repo_id=repo,
+                    revision=info.sha,
+                    allow_patterns=snapshot_patterns([file.rfilename for file in info.siblings]),
+                ))
+                manifest[stage] = {"repo": repo, "revision": info.sha, "path": str(destination)}
+
+        # Save incremental progress, so interrupted all-model downloads can resume.
+        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
+        variables = []
+        for name, entry in manifest.items():
+            key = "OMNISCRIPT_LAYOUT_MODEL" if name == "layout" else MODEL_SPECS[name][1]
+            variables.append(f"export {key}={shlex.quote(entry['path'])}")
+        (artifacts / "models.env").write_text("\n".join(variables) + "\n")
+        print(f"{stage}: ready at {destination}")
+
+    print("Run: source scripts/runpod/env.sh")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as error:
+        raise SystemExit(
+            f"Model download failed: {error}\n"
+            "For gated translation weights, accept access on the AI4Bharat model page "
+            "and authenticate with HF_TOKEN or hf auth login."
+        ) from None
