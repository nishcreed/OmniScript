+#!/usr/bin/env bash
+# Source this from the Pod shell; creation-time variables may not reach SSH shells.
+OMNISCRIPT_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+export HF_HOME="${HF_HOME:-/workspace/hf-cache}"
+export PIP_CACHE_DIR="${PIP_CACHE_DIR:-/workspace/pip-cache}"
+export UV_CACHE_DIR="${UV_CACHE_DIR:-/workspace/uv-cache}"
+export NLTK_DATA="${NLTK_DATA:-/workspace/nltk_data}"
+export OMNISCRIPT_MOCK=0
+export OMNISCRIPT_DEVICE="${OMNISCRIPT_DEVICE:-cuda:0}"
+export OMNISCRIPT_DTYPE="${OMNISCRIPT_DTYPE:-auto}"
+export OMNISCRIPT_TRANSLATION_BATCH_SIZE="${OMNISCRIPT_TRANSLATION_BATCH_SIZE:-4}"
+export OMNISCRIPT_LAYOUT_MODEL="${OMNISCRIPT_LAYOUT_MODEL:-$OMNISCRIPT_REPO_ROOT/models/yolov8x-doclaynet-epoch64-imgsz640-initiallr1e-4-finallr1e-5.pt}"
+export OMNISCRIPT_API_URL="${OMNISCRIPT_API_URL:-http://127.0.0.1:8000}"
+export OMNISCRIPT_VENV="${OMNISCRIPT_VENV:-$OMNISCRIPT_REPO_ROOT/.runpod-venv}"
+if [[ -f "$OMNISCRIPT_REPO_ROOT/artifacts/models.env" ]]; then
+    source "$OMNISCRIPT_REPO_ROOT/artifacts/models.env"
+fi
+if [[ -f "$OMNISCRIPT_VENV/bin/activate" ]]; then
+    source "$OMNISCRIPT_VENV/bin/activate"
+fi
