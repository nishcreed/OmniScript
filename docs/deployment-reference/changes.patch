+def resolve_device() -> Any:
+    import torch
+
+    value = settings.device
+    if value == "auto":
+        value = "cuda:0" if torch.cuda.is_available() else "cpu"
+    device = torch.device(value)
+    if device.type not in {"cuda", "cpu"}:
+        raise ValueError("OMNISCRIPT_DEVICE must be cpu, cuda, cuda:N, or auto.")
+    if device.type == "cuda":
+        if not torch.cuda.is_available():
+            raise RuntimeError("CUDA was requested, but PyTorch cannot access a GPU.")
+        index = device.index if device.index is not None else torch.cuda.current_device()
+        if index >= torch.cuda.device_count():
+            raise ValueError(f"CUDA device {index} does not exist.")
+        device = torch.device(f"cuda:{index}")
+    return device
+
+
+def resolve_dtype(device: Any) -> Any:
+    import torch
+
+    if settings.dtype not in {"auto", "float16", "bfloat16", "float32"}:
+        raise ValueError("OMNISCRIPT_DTYPE must be auto, float16, bfloat16, or float32.")
+    if device.type == "cpu":
+        return torch.float32
+    with torch.cuda.device(device):
+        supports_bf16 = torch.cuda.is_bf16_supported()
+    if settings.dtype == "auto":
+        return torch.bfloat16 if supports_bf16 else torch.float16
+    if settings.dtype == "bfloat16" and not supports_bf16:
+        raise ValueError("This GPU does not support BF16; use float16 or auto.")
+    return getattr(torch, settings.dtype)
+
