+++ b/scripts/smoke.py
@@ -0,0 +1,86 @@
+"""Run real stages separately or the full pipeline with timing and GPU memory."""
+
+import argparse
+import json
+import time
+import wave
+from io import BytesIO
+from pathlib import Path
+
+
+def audio_summary(wav_bytes):
+    with wave.open(BytesIO(wav_bytes)) as audio:
+        return {"audio_bytes": len(wav_bytes), "audio_seconds": round(audio.getnframes() / audio.getframerate(), 2)}
+
+
+def run_stage(stage, image_path, language, text):
+    if stage == "translation":
+        from src.inference.translation import translate_text
+        return {"text": translate_text([text], language)}
+    if stage == "tts":
+        from src.inference.audio import text_to_audio
+        return audio_summary(text_to_audio([text], language=language))
+    if image_path is None or not image_path.is_file():
+        raise ValueError("Supply --image with an existing document image.")
+    if stage == "pipeline":
+        from src.inference import process_document
+        result = process_document(image_path, language=language)
+        return {"text": result.text, **audio_summary(result.audio_bytes)}
+
+    from src.inference.layout import detect_layout
+    page = detect_layout(image_path)
+    summary = {"regions": {label: len(regions) for label, regions in page.regions.items()}}
+    if stage == "layout":
+        return summary
+    if stage in {"ocr", "matching"}:
+        from src.inference.ocr import extract_text
+        texts = extract_text(page)
+        summary["text"] = texts
+    if stage in {"captioning", "matching"}:
+        if not page.regions.get("Picture"):
+            raise ValueError("No Picture regions detected; use a document containing a picture.")
+        from src.inference.captioning import caption_images
+        captions = caption_images(page)
+        summary["captions"] = captions
+        if stage == "matching":
+            from src.inference.matching import associate_images
+            summary["text"] = associate_images(page, texts, captions)
+    return summary
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--stage", choices=["layout", "ocr", "captioning", "matching", "translation", "tts", "pipeline"], required=True)
+    parser.add_argument("--image", type=Path)
+    parser.add_argument("--language", choices=["en", "ta", "hi", "te", "ml", "kn"], default="en")
+    parser.add_argument("--text", default="A bird is sitting on a tree branch.")
+    parser.add_argument("--repeat", type=int, default=1)
+    args = parser.parse_args()
+    if args.repeat < 1:
+        parser.error("--repeat must be positive")
+    if args.stage == "translation" and args.language == "en":
+        parser.error("Use a non-English language to test the translation model")
+
+    import torch
+    from src.model import resolve_device
+    device = resolve_device()
+    for index in range(args.repeat):
+        if device.type == "cuda":
+            torch.cuda.synchronize(device)
+            torch.cuda.reset_peak_memory_stats(device)
+        started = time.perf_counter()
+        result = run_stage(args.stage, args.image, args.language, args.text)
+        if device.type == "cuda":
+            torch.cuda.synchronize(device)
+        report = {"stage": args.stage, "run": index + 1, "seconds": round(time.perf_counter() - started, 2), **result}
+        if device.type == "cuda":
+            report["torch_peak_allocated_gib"] = round(torch.cuda.max_memory_allocated(device) / 2**30, 2)
+            report["torch_peak_reserved_gib"] = round(torch.cuda.max_memory_reserved(device) / 2**30, 2)
+        print(json.dumps(report, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as error:
+        raise SystemExit(f"Smoke check failed: {type(error).__name__}: {error}") from None
