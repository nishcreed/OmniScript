+#!/usr/bin/env bash
+set -euo pipefail
+source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
+cd "$OMNISCRIPT_REPO_ROOT"
+
+if [[ "$(uname -s)" != Linux ]]; then
+    echo 'Run this script on the Linux Runpod Pod, not on your laptop.' >&2
+    exit 1
+fi
+python3 - <<'PY'
+import sys
+import torch
+assert (3, 11) <= sys.version_info[:2] <= (3, 12), 'Use a Python 3.11/3.12 PyTorch template.'
+assert torch.__version__.split('+')[0] == '2.8.0', 'Use Runpod PyTorch 2.8.0.'
+assert torch.cuda.is_available(), 'CUDA is unavailable; check the template/GPU before installing.'
+print('GPU:', torch.cuda.get_device_name(0))
+PY
+if [[ "$EUID" -ne 0 ]]; then
+    echo 'Run setup as root in the official Runpod PyTorch template.' >&2
+    exit 1
+fi
+apt-get update
+DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
+    tesseract-ocr ffmpeg rubberband-cli libsndfile1 libgl1 libglib2.0-0 \
+    build-essential python3-dev python3-venv git
+mkdir -p "$HF_HOME" "$PIP_CACHE_DIR" "$UV_CACHE_DIR" "$NLTK_DATA" artifacts
+if [[ ! -f "$OMNISCRIPT_VENV/bin/python" ]]; then
+    if command -v uv >/dev/null 2>&1; then
+        uv venv --seed --system-site-packages --python "$(command -v python3)" "$OMNISCRIPT_VENV"
+    else
+        python3 -m venv --system-site-packages "$OMNISCRIPT_VENV"
+    fi
+fi
+source "$OMNISCRIPT_VENV/bin/activate"
+if command -v uv >/dev/null 2>&1; then
+    uv pip install --python "$OMNISCRIPT_VENV/bin/python" -r requirements-gpu.txt
+else
+    python -m pip install -r requirements-gpu.txt
+fi
+python -m nltk.downloader -d "$NLTK_DATA" punkt punkt_tab
+python -m pip check
+python -m pip freeze > artifacts/installed-requirements.txt
+python -m scripts.preflight --allow-missing-models
+echo 'Environment ready. Next: python -m scripts.download_models --stage all'
