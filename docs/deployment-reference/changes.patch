+"""Check the Pod environment before spending time loading model weights."""
+
+import argparse
+import importlib
+import json
+import shutil
+import sys
+from pathlib import Path
+
+from src.config import PROJECT_ROOT, settings
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--allow-missing-models", action="store_true")
+    args = parser.parse_args()
+    failures = []
+
+    def check(label, ok, detail):
+        print(f"{'OK' if ok else 'FAIL'} {label}: {detail}")
+        if not ok:
+            failures.append(label)
+
+    check("Python", (3, 11) <= sys.version_info[:2] <= (3, 12), sys.version.split()[0])
+    for executable in ("ffmpeg", "rubberband", settings.tesseract_command):
+        found = shutil.which(executable)
+        check(executable, bool(found), found or "missing system package")
+
+    for module in ("torch", "torchvision", "transformers", "accelerate", "ultralytics", "pytesseract", "nltk", "gtts", "pydub", "pyrubberband", "soundfile", "gradio", "httpx", "IndicTransToolkit", "sentencepiece"):
+        try:
+            loaded = importlib.import_module(module)
+            check(module, True, getattr(loaded, "__version__", "importable"))
+        except Exception as error:
+            check(module, False, str(error))
+
+    try:
+        import torch
+        from src.model import resolve_device, resolve_dtype
+
+        check("CUDA", torch.cuda.is_available(), torch.version.cuda)
+        device = resolve_device()
+        if device.type == "cuda":
+            print(f"GPU: {torch.cuda.get_device_name(device)}")
+            print(f"VRAM: {torch.cuda.get_device_properties(device).total_memory / 2**30:.1f} GiB")
+        print(f"Selected device/dtype: {device}/{resolve_dtype(device)}")
+        check("Torch baseline", torch.__version__.split("+")[0] == "2.8.0", torch.__version__)
+        from transformers import Blip2ForConditionalGeneration, Blip2ForImageTextRetrieval, AutoTokenizer
+        print("BLIP-2 and translation classes: importable")
+    except Exception as error:
+        check("GPU/model API", False, str(error))
+
+    try:
+        import nltk
+        from nltk.tokenize import sent_tokenize
+        check("Sentence tokenizer", len(sent_tokenize("First sentence. Second sentence.")) == 2, "punkt resources")
+    except Exception as error:
+        check("Sentence tokenizer", False, str(error))
+
+    if not args.allow_missing_models:
+        check("Layout checkpoint", settings.layout_model_path.is_file(), str(settings.layout_model_path))
+        for name, value in (("Caption", settings.caption_model), ("Matching", settings.itm_model), ("Translation", settings.translation_model)):
+            path = Path(value)
+            has_weights = path.is_dir() and (
+                any(path.glob("*.safetensors")) or any(path.glob("*.bin"))
+            )
+            check(f"{name} snapshot", has_weights and (path / "config.json").is_file(), value)
+
+    free = shutil.disk_usage(PROJECT_ROOT).free / 2**30
+    print(f"Free repository storage: {free:.1f} GiB")
+    print("TTS requires outbound internet access to Google; verify with the tts smoke stage.")
+    artifacts = PROJECT_ROOT / "artifacts"
+    artifacts.mkdir(exist_ok=True)
+    (artifacts / "preflight.json").write_text(json.dumps({"python": sys.version, "failures": failures, "free_disk_gib": free}, indent=2) + "\n")
+    return int(bool(failures))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
