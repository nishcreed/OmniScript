+++ b/tests/test_gpu_preparation.py
@@ -0,0 +1,165 @@
+"""Verify model configuration and translation wiring without installing Torch."""
+
+import importlib
+import subprocess
+import sys
+import tempfile
+import unittest
+from contextlib import nullcontext
+from dataclasses import replace
+from types import ModuleType, SimpleNamespace
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+
+class Device:
+    def __init__(self, value):
+        parts = str(value).split(":")
+        self.type = parts[0]
+        self.index = int(parts[1]) if len(parts) > 1 else None
+
+    def __str__(self):
+        return self.type if self.index is None else f"{self.type}:{self.index}"
+
+
+class ModelConfigurationTests(unittest.TestCase):
+    def setUp(self):
+        self.models = importlib.import_module("src.model")
+        self.torch = ModuleType("torch")
+        self.torch.device = Device
+        for dtype in ("float16", "bfloat16", "float32"):
+            setattr(self.torch, dtype, dtype)
+        self.torch.cuda = MagicMock()
+        self.torch.cuda.is_available.return_value = True
+        self.torch.cuda.device_count.return_value = 1
+        self.torch.cuda.current_device.return_value = 0
+        self.torch.cuda.is_bf16_supported.return_value = True
+        self.torch.cuda.device.side_effect = lambda device: nullcontext()
+        self.addCleanup(self.models.load_captioning_model.cache_clear)
+        self.models.load_captioning_model.cache_clear()
+
+    def test_auto_uses_bf16_cuda_and_fp32_cpu(self):
+        with patch.dict(sys.modules, {"torch": self.torch}), patch.object(self.models, "settings", replace(self.models.settings, device="auto", dtype="auto")):
+            device = self.models.resolve_device()
+            self.assertEqual(str(device), "cuda:0")
+            self.assertEqual(self.models.resolve_dtype(device), "bfloat16")
+            self.torch.cuda.is_available.return_value = False
+            device = self.models.resolve_device()
+            self.assertEqual(str(device), "cpu")
+            self.assertEqual(self.models.resolve_dtype(device), "float32")
+
+    def test_auto_falls_back_to_fp16_on_gpu_without_bf16(self):
+        self.torch.cuda.is_bf16_supported.return_value = False
+        with patch.dict(sys.modules, {"torch": self.torch}), patch.object(self.models, "settings", replace(self.models.settings, dtype="auto")):
+            self.assertEqual(self.models.resolve_dtype(Device("cuda:0")), "float16")
+
+    def test_explicit_cuda_fails_if_gpu_missing(self):
+        self.torch.cuda.is_available.return_value = False
+        with patch.dict(sys.modules, {"torch": self.torch}), patch.object(self.models, "settings", replace(self.models.settings, device="cuda")):
+            with self.assertRaisesRegex(RuntimeError, "cannot access a GPU"):
+                self.models.resolve_device()
+
+    def test_caption_loader_places_model_and_caches_it(self):
+        transformers = ModuleType("transformers")
+        transformers.Blip2Processor = MagicMock()
+        transformers.Blip2ForConditionalGeneration = MagicMock()
+        loaded = MagicMock()
+        loaded.to.return_value = loaded
+        transformers.Blip2ForConditionalGeneration.from_pretrained.return_value = loaded
+        with patch.dict(sys.modules, {"torch": self.torch, "transformers": transformers}), patch.object(self.models, "settings", replace(self.models.settings, device="cuda", dtype="auto")):
+            first = self.models.load_captioning_model()
+            second = self.models.load_captioning_model()
+        self.assertIs(first, second)
+        self.assertEqual(transformers.Blip2ForConditionalGeneration.from_pretrained.call_args.kwargs["torch_dtype"], "bfloat16")
+        self.assertEqual(str(loaded.to.call_args.args[0]), "cuda:0")
+        loaded.eval.assert_called_once()
+        transformers.Blip2ForConditionalGeneration.from_pretrained.assert_called_once()
+
+    def test_stage_import_does_not_import_torch_or_audio(self):
+        subprocess.run(
+            [sys.executable, "-c", "import sys; from src.inference.layout import calculate_iou; assert calculate_iou([0,0,1,1], [0,0,1,1]) == 1; assert 'torch' not in sys.modules; assert 'src.inference.audio' not in sys.modules"],
+            check=True, capture_output=True,
+        )
+
+
+class TranslationWiringTests(unittest.TestCase):
+    def test_hf_tokenizer_interface_and_marker_restoration(self):
+        translation = importlib.import_module("src.inference.translation")
+        torch = ModuleType("torch")
+        torch.inference_mode = nullcontext
+        toolkit = ModuleType("IndicTransToolkit")
+        processor = MagicMock()
+        processor.preprocess_batch.side_effect = lambda batch, **kwargs: batch
+        processor.postprocess_batch.side_effect = lambda batch, **kwargs: batch
+        toolkit.IndicProcessor = MagicMock(return_value=processor)
+
+        class Tokenizer:
+            # Old src=True/src=False flags will fail against this HF interface.
+            def __call__(self, texts, *, return_tensors, padding, truncation):
+                if truncation:
+                    raise AssertionError("Do not silently discard document text")
+                return {"input_ids": SimpleNamespace(to=lambda device: texts)}
+
+            def batch_decode(self, tokens, *, skip_special_tokens, clean_up_tokenization_spaces):
+                return [f"Translated {text}" for text in tokens]
+
+        model = MagicMock()
+        model.parameters.side_effect = lambda: iter([SimpleNamespace(device="cuda:0")])
+        model.generate.side_effect = lambda **kwargs: kwargs["input_ids"]
+        with patch.dict(sys.modules, {"torch": torch, "IndicTransToolkit": toolkit}), patch.object(translation, "load_translation_model", return_value=(model, Tokenizer())):
+            result = translation.translate_text(["Hello.", "_*A picture*_."], "ta", batch_size=1)
+        self.assertEqual(result, ["Translated Hello.", "_*Translated A picture*_."])
+        self.assertEqual(model.generate.call_count, 2)
+
